{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "revalidate-midnight": {
      "schedule": "0 0 * * *",
      "timezone": "Asia/Seoul",
      "path": "/api/revalidate",
      "requestMethod": "GET"
    },
    "revalidate-noon": {
      "schedule": "0 12 * * *",
      "timezone": "Asia/Seoul",
      "path": "/api/revalidate",
      "requestMethod": "GET"
    }
  }
}
